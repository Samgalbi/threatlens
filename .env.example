# ==============================================================================
# ThreatLens - environment variables
# Copy to .env and fill the empty values. NEVER commit .env (it is in .gitignore).
# ==============================================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Qdrant (vector DB) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=threatlens_kb
# Optional in dev, mandatory in prod
QDRANT_API_KEY=

# --- PostgreSQL 16 (conversation history, S4) ---
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=
POSTGRES_DB=threatlens
POSTGRES_PORT=5432
# Async driver required by SQLAlchemy 2.0 async (S4)
DATABASE_URL=postgresql+asyncpg://threatlens:CHANGE_ME@127.0.0.1:5432/threatlens

# --- Models (CPU, ONNX via fastembed) ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SPARSE_MODEL_NAME=Qdrant/bm25
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
FASTEMBED_CACHE_PATH=./models

# --- LLM (S4) : groq (main) | ollama (offline fallback) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
